# Copy to backend/.env and adjust. Never commit the real .env.
TS_ENV=dev
TS_SECRET_KEY=change-me-to-a-random-string-of-at-least-32-characters
TS_ADMIN_PASSWORD=ChangeMe#2026
TS_DATABASE_URL=sqlite:///./tourist_safety.db
TS_KEYS_DIR=./keys
TS_MODELS_DIR=./models
TS_DEMO_ENABLED=true
TS_RATE_LIMIT_ENABLED=true
# 0 disables the per-minute detection loop
TS_DETECTION_INTERVAL_S=60
TS_CORS_ORIGINS=["http://localhost:5173"]
